rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCollegeDomain() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        (request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@francisxavier[.]ac[.]in$') ||
         request.auth.token.email == 'asirselvin446@gmail.com');
    }

    // Developer bootstrap — always privileged so admins can never be locked out.
    function isDeveloper() {
      return isSignedIn() && request.auth.token.email == 'asirselvin446@gmail.com';
    }

    // Role assigned via the app's Roles tab (settings/global -> roleAssignments: email -> role).
    // Evaluated lazily; callers must short-circuit before it when possible.
    function assignedRole() {
      return get(/databases/$(database)/documents/settings/global).data.roleAssignments[request.auth.token.email];
    }

    // Faculty roles allowed to use the admin dashboard (mirrors the app's UI gating).
    function isPrivileged() {
      return isCollegeDomain() && (
        isDeveloper() ||
        assignedRole() in ['developer', 'primary_admin', 'admin', 'staff']
      );
    }

    // Roles allowed to change global settings and delete users.
    function isAdmin() {
      return isCollegeDomain() && (
        isDeveloper() ||
        assignedRole() in ['developer', 'primary_admin', 'admin']
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Feature flags, batches, announcements, custom problems, overrides, role map.
    // Reads: any signed-in user (students need the flags).
    // Writes: faculty admins only (previously: any student could rewrite these).
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles and progress subcollections.
    // Reads: the owner, or faculty (the admin roster needs college-wide read).
    //         (previously: every student could read everyone's submissions)
    // Writes: the owner (own progress/submissions), or faculty (admin actions).
    //         (previously: every student could rewrite anyone's record)
    // Deletes: faculty admins only.
    match /users/{userId} {
      allow read: if isCollegeDomain() && (isOwner(userId) || isPrivileged());
      allow create, update: if isCollegeDomain() && (isOwner(userId) || isPrivileged());
      allow delete: if isAdmin();

      // Progress subcollections (e.g. progress/current)
      match /{allSubcollections=**} {
        allow read: if isCollegeDomain() && (isOwner(userId) || isPrivileged());
        allow create, update: if isCollegeDomain() && (isOwner(userId) || isPrivileged());
        allow delete: if isAdmin();
      }
    }

    // Top-level collections allow blocks for college-domain users and faculty admins
    match /custom_problems/{problemId} {
      allow read: if isCollegeDomain();
      allow write: if isAdmin();
    }

    match /problem_overrides/{problemId} {
      allow read: if isCollegeDomain();
      allow write: if isAdmin();
    }

    match /problems/{problemId} {
      allow read: if isCollegeDomain();
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if isCollegeDomain();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isCollegeDomain();
      allow write: if isAdmin();
    }

    match /leaderboard/{studentId} {
      allow read: if isCollegeDomain();
      allow write: if isAdmin();
    }
  }
}
