rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCollegeDomain() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        (request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@francisxavier[.]ac[.]in$') ||
         request.auth.token.email == 'asirselvin446@gmail.com');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Admin settings document
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isCollegeDomain();
    }

    // Leaderboard document
    match /leaderboard/{studentId} {
      allow read: if true;
      allow write: if isCollegeDomain();
    }

    // User profile document
    match /users/{userId} {
      allow read: if isCollegeDomain();
      allow create, update: if isCollegeDomain();
      allow delete: if isCollegeDomain();

      // User progress subcollection
      match /progress/{progressId} {
        allow read: if isCollegeDomain();
        allow create, update: if isCollegeDomain();
        allow delete: if isCollegeDomain();
      }
    }
  }
}
