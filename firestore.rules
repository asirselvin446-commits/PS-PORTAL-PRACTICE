rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isCollegeDomain() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@francisxavier[.]ac[.]in$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'college']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'college', 'createdAt', 'lastLoginAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email == request.auth.token.email &&
        data.displayName is string && data.displayName.size() <= 128 &&
        data.college is string && data.college == 'Francis Xavier Engineering College' &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'solvedProblems', 'attemptedProblems']) &&
        data.keys().hasOnly(['userId', 'solvedProblems', 'attemptedProblems', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.solvedProblems is list && data.solvedProblems.size() <= 500 &&
        data.attemptedProblems is list && data.attemptedProblems.size() <= 500;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isCollegeDomain() && request.auth.uid == userId && isValidId(userId);
      allow create: if isCollegeDomain() && request.auth.uid == userId && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isCollegeDomain() && request.auth.uid == userId && isValidId(userId) && isValidUser(request.resource.data) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      // User progress subcollection
      match /progress/{progressId} {
        allow get: if isCollegeDomain() && request.auth.uid == userId && isValidId(userId) && isValidId(progressId);
        allow create: if isCollegeDomain() && request.auth.uid == userId && isValidId(userId) && isValidId(progressId) && isValidProgress(request.resource.data);
        allow update: if isCollegeDomain() && request.auth.uid == userId && isValidId(userId) && isValidId(progressId) && isValidProgress(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
